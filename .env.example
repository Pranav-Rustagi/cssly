# Public origin of the site, used for metadataBase, the sitemap and
# robots.txt. No trailing slash (one is stripped anyway).
NEXT_PUBLIC_SITE_URL=

# EmailJS config for the contact form (app/contact). All five are public
# by design — EmailJS is a browser-side send, so its "public key" is meant
# to be exposed. Get these from the EmailJS dashboard (emailjs.com):
# Service ID and Template ID from your configured service/template, the
# Public Key from Account > General.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_TO_NAME=
NEXT_PUBLIC_EMAILJS_TO_EMAIL=
